{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "pwa-chrome",
      "request": "launch",
      "name": "Debug Personal Site",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "/@fs/*": "${workspaceFolder}/*",
        "/src/*": "${workspaceFolder}/src/*",
        "/@/*": "${workspaceFolder}/src/*",
        "/*": "*"
      },
      "preLaunchTask": "Start Dev Server",
      "postDebugTask": "Terminate Dev Server"
    }
  ]
}
